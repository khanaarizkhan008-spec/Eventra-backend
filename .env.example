# Server
PORT=4000
# Optional explicit public backend URL (Render automatically sets RENDER_EXTERNAL_URL)
BACKEND_PUBLIC_URL=https://your-backend-service.onrender.com
# Optional comma-separated frontend origins (defaults to *)
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# Frontend Base URL (used in email ticket links & fallback return_url)
APP_BASE_URL=https://your-frontend.vercel.app

# Supabase Admin Credentials (NEVER expose SERVICE_ROLE_KEY in frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cashfree Payments Credentials
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# Cryptographic QR Signing & Cron Secrets
QR_SIGNING_SECRET=replace-with-64-char-random-hex
CRON_SECRET=replace-with-random-cron-secret

# Optional Resend Email Notifications
RESEND_API_KEY=
EMAIL_FROM=Eventra <tickets@yourdomain.com>

